# --- Secrets (never commit) ---
.env
*.env
.env.*
*.key
*secret*
# ...but DO commit the template so others know what to fill in
!.env.example
!**/.env.example

# --- Claude Code per-machine settings (personal paths + local permissions) ---
**/.claude/settings.local.json

# --- Python / dashboard ---
__pycache__/
*.py[cod]
.pytest_cache/
# Scratch space: downloaded PDFs, screenshots, and working research. Never ships.
/tmp/
.venv/
venv/
env/
dist/
build/
*.egg-info/

# --- Obsidian (per-machine UI state & cache) ---
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.trash/

# --- OS cruft ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Syncthing (per-machine sync markers, ignore rules, and file versions) ---
.stfolder/
.stignore
.stversions/

# --- Logs ---
*.log

# --- Chat attachments (per-session uploads; never committed) ---
dashboard/.chat_attachments/

# --- Chat transcripts (multi-chat store; personal, never committed) ---
dashboard/.chats/

# --- To-do list (personal task store; never committed) ---
dashboard/.todos.json

# Agent dispatch database + isolated/staged worker folders (personal, never committed)
dashboard/.dispatches.sqlite3*
dashboard/.dispatch_work/

# --- Email OAuth tokens + client secrets (per-account; never committed) ---
dashboard/.email_tokens/
dashboard/client_secret*.json
dashboard/*.oauth.json

# --- Cloned external repos ---
codex-plugin-cc/

# --- Tailwind standalone CLI binary (~108MB; re-fetch via dashboard/get-tailwind.bat) ---
dashboard/tools/tailwindcss*
dashboard/tools/*.exe

# --- Private content: only the skeleton (dashboard + vault framework) is pushed ---
# Classes, internships, personal projects, persona files, and the resume stay local only.
internship-projects/
schoolwork/
research/
roblox_dev/
my_evil_twin/
resume/
archive/courses/

# --- Vendored third-party reading material (own license; fetch upstream instead) ---
ideas/research-archive/RAG-pipelines/resources/ai-system-design-guide-main/

# --- Regalia settings store (may hold API keys; per-machine) ---
dashboard/.config.json
dashboard/.external.json
# launch-shortcut icon generated from Assets/Regalia_Icon.png (autostart.py)
dashboard/.regalia.ico

# --- PyInstaller build outputs (regalia.spec stays tracked) ---
dashboard/build/
dashboard/dist/
# Packaged release archives (CI builds + attaches these to the GitHub Release).
dashboard/Regalia-windows.zip
dashboard/Regalia-macos-arm64.zip

# --- Founder's Edition: the creator's personal workflow, kept LOCAL only. ---
# Regalia ships workflow-agnostic; a de-identified, opt-in copy of the reusable
# parts lives in founders-edition/ (tracked). These in-place originals stay on
# disk so the creator's own Cursor/Claude setup keeps working, but never ship.
/projects/CLAUDE.md
/ideas/research-archive/CLAUDE.md
/ideas/research-archive/claude-cursor-rules-levels.md
/.cursor/rules/internship.mdc
/.cursor/rules/projects.mdc
/.cursor/rules/research.mdc
/.cursor/rules/archive-*.mdc
/.claude/skills/
/skills/course-setup/
/templates/skills/
